<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd" version="6.0">
	
	<display-name />

	<!-- Log4j 2 (log4j-jakarta-web): automatic initialization is disabled so the Log4j listener and
	     filter can be declared explicitly below.  The Log4j listener is declared FIRST so that Log4j is
	     shut down LAST, after the other listeners (which log during shutdown) have finished. -->
	<context-param>
		<param-name>isLog4jAutoInitializationDisabled</param-name>
		<param-value>true</param-value>
	</context-param>

	<!-- The Struts ActionServlet (mapped to *.do, config /WEB-INF/struts-config.xml) has been
	     removed: all actions are migrated to the Spring MVC DispatcherServlet below, no JSP uses
	     Struts taglibs, and message resources are loaded directly by StrutsActionMessagesResolver.
	     struts-config.xml is no longer loaded. -->

	<!-- Spring MVC DispatcherServlet - replaced Struts. Handles all *.do requests
	     (every former Struts action is now a @Controller). WebMvcConfig sets
	     UrlPathHelper.alwaysUseFullPath=true so the handler lookup path is the full
	     path within the app (e.g. /peptide.do), matching @RequestMapping("/peptide.do"). -->
	<servlet>
		<servlet-name>springDispatcher</servlet-name>
		<servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
		<init-param>
			<param-name>contextClass</param-name>
			<param-value>org.springframework.web.context.support.AnnotationConfigWebApplicationContext</param-value>
		</init-param>
		<init-param>
			<param-name>contextConfigLocation</param-name>
			<param-value>org.yeastrc.xlink.www.spring_config.WebMvcConfig</param-value>
		</init-param>
		<load-on-startup>2</load-on-startup>
	</servlet>
	<servlet-mapping>
		<servlet-name>springDispatcher</servlet-name>
		<url-pattern>*.do</url-pattern>
	</servlet-mapping>
	<welcome-file-list>
		<welcome-file>index.jsp</welcome-file>
	</welcome-file-list>

  <!-- REST Webservices by JAX-RS Jersey Servlet -->
    <servlet>
        <servlet-name>JAX-RS REST Jersey Servlet</servlet-name>
        <servlet-class>org.glassfish.jersey.servlet.ServletContainer</servlet-class>
        <init-param>
            <param-name>jersey.config.server.provider.packages</param-name>
            
            <!-- specifies the packages to scan for Classes that have Jersey annotations for webservices -->
            <!-- Adding "jackson.jaxrs" changes the JSON and JAXB XML provider to Jackson -->
            <param-value>com.fasterxml.jackson.jaxrs;org.yeastrc.xlink.www.webservices;org.yeastrc.xlink.www.file_import_proxl_xml_scans.webservices;org.yeastrc.xlink.www.user_account_webservices;org.yeastrc.xlink.www.url_shortner_share_page.webservices;org.yeastrc.xlink.www.webservices_data_pages_main_get_data_webservices</param-value>
        </init-param>  
        
        <load-on-startup>1</load-on-startup>
    </servlet>
  
  <servlet-mapping>
  	<servlet-name>JAX-RS REST Jersey Servlet</servlet-name>
  	<url-pattern>/services/*</url-pattern>
  </servlet-mapping>

	<!--  Servlet for handling shortened URLs, redirects to full URL  -->

  <servlet>
    <servlet-name>Shortened_URL_Servlet</servlet-name>
    <servlet-class>org.yeastrc.xlink.www.url_shortner_share_page.url_handler_servlet.SharePageURLHandlerServlet</servlet-class>
    <load-on-startup>3</load-on-startup>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>Shortened_URL_Servlet</servlet-name>
    <url-pattern>/go</url-pattern>
  </servlet-mapping>

	<!--  Servlet for handling custom project label, redirects to standard project URL  -->

  <servlet>
    <servlet-name>ProjectLabel_Servlet</servlet-name>
    <servlet-class>org.yeastrc.xlink.www.project_short_name_label.handler_servlet.ProjectLabelServlet</servlet-class>
    <load-on-startup>4</load-on-startup>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>ProjectLabel_Servlet</servlet-name>
    <url-pattern>/p/*</url-pattern>
  </servlet-mapping>
  
  <!-- Filters - run on each request -->
   

    <!-- Log4j 2 filter.  Declared because Log4j automatic initialization is disabled (see context-param above) -->
    <filter>
        <filter-name>log4jServletFilter</filter-name>
        <filter-class>org.apache.logging.log4j.web.Log4jServletFilter</filter-class>
        <async-supported>true</async-supported>
    </filter>
    <filter-mapping>
        <filter-name>log4jServletFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>FORWARD</dispatcher>
        <dispatcher>INCLUDE</dispatcher>
        <dispatcher>ERROR</dispatcher>
        <dispatcher>ASYNC</dispatcher>
    </filter-mapping>

    <!-- filter to set character encoding on each request -->
    
    <filter>
        <filter-name>Set Character Encoding</filter-name>
        <filter-class>org.apache.filters.SetCharacterEncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
        <init-param>
            <param-name>ignore</param-name>
            <param-value>false</param-value>
        </init-param>
    </filter>

    <filter-mapping>
        <filter-name>Set Character Encoding</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>



	<!-- This filter will be the Second called for a request and keeps the  -->
    <filter>
	  <filter-name>SSOSessionKeepAliveServletFilter</filter-name>
	  <filter-class>org.yeastrc.xlink.www.servlet_filter.SSOSessionKeepAliveServletFilter</filter-class>
    </filter>

	<filter-mapping>
	  <filter-name>SSOSessionKeepAliveServletFilter</filter-name>
	  <url-pattern>/*</url-pattern> 
	</filter-mapping>	

 

	<!-- This filter will be the Third called for a request and does initial setup -->
    <filter>
	  <filter-name>InitialServletFilter</filter-name>
	  <filter-class>org.yeastrc.xlink.www.servlet_filter.InitialServletFilter</filter-class>
    </filter>

	<filter-mapping>
	  <filter-name>InitialServletFilter</filter-name>
	  <url-pattern>/*</url-pattern> 
	</filter-mapping>	

 



	<!-- Servlet Context Listeners.  Called on Web app startup and shutdown -->

	<!-- Log4j 2 listener.  MUST be the first listener:  listeners are shut down in reverse order,
	     so Log4j is shut down after the listeners below, which log during shutdown. -->
	<listener>
		<listener-class>org.apache.logging.log4j.web.Log4jServletContextListener</listener-class>
	</listener>

	<listener>
		<listener-class>
		org.yeastrc.xlink.www.servlet_context.ServletContextAppListener
		</listener-class>
	</listener>

	<!-- Optionally overrides the HTTP session inactivity timeout per-deployment via the
	     env var PROXL_SESSION_TIMEOUT_MINUTES.  If the var is unset/blank/invalid, no
	     override is applied and the servlet-container default session timeout is used. -->
	<listener>
		<listener-class>
		org.yeastrc.xlink.www.servlet_context.ProxlSessionTimeoutHttpSessionListener
		</listener-class>
	</listener>

	<!-- ERROR pages -->
	
    <error-page>
	    <!-- Uncaught exception -->
	    <error-code>500</error-code>
	    <location>/WEB-INF/jsp-pages/generalError.jsp</location>
	</error-page>
	<error-page>
	    <!-- Unsupported servlet method -->
	    <error-code>503</error-code>
	    <location>/WEB-INF/jsp-pages/generalError.jsp</location>
	</error-page>
  

</web-app>

